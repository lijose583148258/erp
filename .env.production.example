# Production Environment Configuration
# Copy this file to .env.production
# Note: For Vite, variables must start with VITE_ to be exposed to the client
# But since we are using 'loadEnv' in vite.config.ts to define process.env, we can use these names.

NODE_ENV=production

# Backend API URL (for Axios)
# In production, if served by Nginx on the same domain, this can be /api
VITE_API_BASE_URL=/api
VITE_API_ABSOLUTE_URL=/api
VITE_USE_MOCK=false

# Gemini API Key (Optional)
GEMINI_API_KEY=your_production_api_key_here

# Backend environment variables. Keep writable data outside immutable app bundles.
PORT=5001
# Single-machine default: SQLite volume-backed deployment
DATABASE_URL=file:./prisma/prod.db
# Local/EXE runtime can override the SQLite path without changing DATABASE_URL.
# Windows example: AILAODA_RUNTIME_DB_PATH=D:\AilaoDaRuntime\stable.db
AILAODA_RUNTIME_DB_PATH=
# Optional PostgreSQL target for later scaling
# DATABASE_URL=postgresql://postgres:password@postgres:5432/pro_sales?schema=public
# Must be replaced before any real server deployment.
JWT_SECRET=replace_with_a_long_random_secret_before_server_deploy
CORS_ORIGIN=http://127.0.0.1:5001,http://localhost:5001,http://your-domain.com,https://your-domain.com

# Runtime writable directories. Keep them outside the immutable app bundle on server/EXE.
BACKUP_DIR=backups
LOG_DIR=logs
UPLOAD_DIR=runtime-uploads
FRONTEND_DIST_DIR=dist
SERVE_FRONTEND=true
TRUST_PROXY=true
BACKUP_RETENTION_DAYS=90

# Rate limiting. Tune these for server traffic after the two-month local soak.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=2000

# Docker compose host port. Container port remains 5001.
AILAODA_HTTP_PORT=5001
