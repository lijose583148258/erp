# Production Environment Configuration
# Copy this file to .env.production
# Note: For Vite, variables must start with VITE_ to be exposed to the client
# But since we are using 'loadEnv' in vite.config.ts to define process.env, we can use these names.

NODE_ENV=production
# Deployment shape:
# local   = Windows/local package, SQLite supported
# private = private single-server deployment, SQLite supported for small pilots; PostgreSQL target requires a PostgreSQL build
# saas    = cloud SaaS, PostgreSQL required; current SQLite runtime will refuse to start
AILAODA_DEPLOYMENT_MODE=local

# Backend API URL (for Axios)
# In production, if served by Nginx on the same domain, this can be /api
VITE_API_BASE_URL=/api
VITE_API_ABSOLUTE_URL=/api
VITE_USE_MOCK=false

# Gemini API Key (Optional)
GEMINI_API_KEY=your_production_api_key_here

# Backend environment variables. Keep writable data outside immutable app bundles.
PORT=5001
# Single-machine default: SQLite in a writable runtime directory, not under immutable prisma source files.
DATABASE_URL=file:./runtime-data/stable.db
# Docker/Linux server example: DATABASE_URL=file:/data/stable.db
# Local/EXE runtime can override the SQLite path without changing DATABASE_URL.
# Windows example: AILAODA_RUNTIME_DB_PATH=D:\AilaoDaRuntime\stable.db
AILAODA_RUNTIME_DB_PATH=
# Optional PostgreSQL target for later scaling
# DATABASE_URL=postgresql://postgres:password@postgres:5432/pro_sales?schema=public
# Must be replaced before any real server deployment.
JWT_SECRET=replace_with_a_long_random_secret_before_server_deploy
# Optional pointer used by deployment docs/operators. The current runtime still
# reads JWT_SECRET from env; future Vault/Secret Manager integration should
# resolve this reference through backend/src/security/secretManagement.ts.
SECRET_MANAGER_REFERENCE=
# Optional MFA gate for privileged roles. Enable for server deployments by
# setting roles such as admin,manager and a Base32 TOTP secret from the operator
# password manager or future secret manager.
AILAODA_MFA_REQUIRED_ROLES=
AILAODA_MFA_TOTP_SECRET=
# Optional outbound webhooks. Use JSON for per-endpoint event filters/secrets:
# AILAODA_WEBHOOK_ENDPOINTS=[{"url":"https://partner.example/webhooks/ailaoda","events":["order.created","payment.verified"]}]
# If endpoint.secret is omitted, AILAODA_WEBHOOK_SECRET signs all configured endpoints.
AILAODA_WEBHOOK_ENDPOINTS=
AILAODA_WEBHOOK_SECRET=
AILAODA_WEBHOOK_TIMEOUT_MS=5000
CORS_ORIGIN=http://127.0.0.1:5001,http://localhost:5001,http://your-domain.com,https://your-domain.com
# Release packages should reject seeded demo credentials such as admin/admin123.
AILAODA_BLOCK_DEMO_CREDENTIALS=1

# Runtime writable directories. Keep them outside the immutable app bundle on server/EXE.
BACKUP_DIR=backups
LOG_DIR=logs
UPLOAD_DIR=runtime-uploads
# File storage. Keep local for desktop/private pilots. Use s3/minio for object storage.
FILE_STORAGE_DRIVER=local
# MinIO/S3 target. Required when FILE_STORAGE_DRIVER=s3 or minio.
S3_ENDPOINT=http://minio:9000
S3_ENDPOINTS=
S3_MIN_WRITE_SUCCESSES=1
S3_REQUEST_TIMEOUT_MS=3000
S3_REGION=us-east-1
S3_BUCKET=ailaoda-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
FRONTEND_DIST_DIR=dist
SERVE_FRONTEND=true
TRUST_PROXY=true
BACKUP_RETENTION_DAYS=90
# report-only keeps local soak safe: the service reports what would be removed but does not delete.
# Change to enforce only after a verified off-machine backup policy exists.
BACKUP_RETENTION_MODE=report-only
# Optional guardrails for long local soak/server deployment. Keep enough headroom; newest backup is always retained.
BACKUP_MAX_FILES=800
BACKUP_MAX_TOTAL_MB=8192

# Rate limiting. Tune these for server traffic after the two-month local soak.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=2000
PUBLIC_PROBE_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_PROBE_RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=8
LOGIN_IP_RATE_LIMIT_MAX=100

# Distributed auth/session/realtime boundary. Required for SaaS and multi-instance deployments.
# URL-encode special characters in the password when constructing REDIS_URL.
REDIS_URL=
REDIS_PASSWORD=
REDIS_SENTINELS=
REDIS_MASTER_NAME=
REDIS_SENTINEL_PASSWORD=
AUTH_TOKEN_STORE_DRIVER=memory
AUTH_TOKEN_KEY_PREFIX=ailaoda:auth
REFRESH_TOKEN_TTL_MS=604800000
LOGIN_RATE_LIMIT_STORE=memory
LOGIN_RATE_LIMIT_KEY_PREFIX=ailaoda:rate-limit:login:
API_RATE_LIMIT_KEY_PREFIX=ailaoda:rate-limit:api:
REALTIME_BUS_DRIVER=memory
REALTIME_REDIS_CHANNEL=ailaoda:realtime:notifications
REDIS_CONNECT_TIMEOUT_MS=1500
REDIS_COMMAND_TIMEOUT_MS=1500

# Search boundary. Default stays on Prisma fallback for local/private pilots.
# Meilisearch can be enabled for customer/order candidate ID recall. Prisma
# still applies business filters and data-scope permissions.
SEARCH_DRIVER=prisma
SEARCH_ENDPOINT=
SEARCH_ENDPOINTS=
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
ELASTICSEARCH_URL=
SEARCH_INDEX_PREFIX=ailaoda
SEARCH_MAX_QUERY_LENGTH=120
SEARCH_REQUEST_TIMEOUT_MS=1500
SEARCH_RESULT_CACHE_TTL_SECONDS=5
MEILISEARCH_PORT=7700

# Observability rehearsal. Docker mounts this one-line bearer token file into
# both the app and Prometheus, so the collector credential cannot drift.
AILAODA_METRICS_BEARER_TOKEN=
AILAODA_METRICS_BEARER_TOKEN_FILE=./runtime-secrets/metrics-bearer-token.txt
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=ailaoda-erp-crm
VITE_AILAODA_ALLOW_BROWSER_EXTERNAL_AI=false

# Remote model calls are server-owned and remain disabled until an approved
# provider, allowlisted host, model, and secret file are configured.
AI_GATEWAY_EXTERNAL_ENABLED=false
AI_GATEWAY_ENDPOINT=
AI_GATEWAY_ALLOWED_HOSTS=
AI_GATEWAY_MODEL=
AI_GATEWAY_API_KEY_FILE=
AI_GATEWAY_TIMEOUT_MS=12000
AI_GATEWAY_MAX_TOKENS=500
AI_GATEWAY_MAX_RESPONSE_BYTES=65536
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_KEY_PREFIX=ailaoda:rate-limit:ai:
AI_DAILY_TOKEN_BUDGET=50000
AI_BUDGET_KEY_PREFIX=ailaoda:ai:budget:
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_FAILURE_WINDOW_SECONDS=300
AI_CIRCUIT_OPEN_SECONDS=60
AI_CIRCUIT_KEY_PREFIX=ailaoda:ai:circuit:
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# Docker compose host port. Container port remains 5001.
AILAODA_HTTP_PORT=5001
