# 环境配置
NODE_ENV=development
PORT=5001

# 数据库配置
# 单机默认使用 SQLite，方便直接启动和备份
DATABASE_URL="file:%LOCALAPPDATA%/AilaoDaRuntime/stable.db"
# 爱牢达稳定运行优先使用 D 盘运行库；如果机器没有 D 盘，runtime 会自动回退到可写目录
AILAODA_RUNTIME_DB_PATH=D:\AilaoDaRuntime\stable.db
# 后续如果要切到 PostgreSQL，可改成下面的形式
# DATABASE_URL="postgresql://postgres:password@localhost:5432/pro_sales?schema=public"

# JWT 配置
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 邮件配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-password

# 文件上传
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS 配置
# 稳定入口是 5001；开发调试入口只保留本项目 Vite 3000，不默认放行其他开发端口
CORS_ORIGIN=http://127.0.0.1:5001,http://localhost:5001,http://localhost:3000,http://127.0.0.1:3000

# 日志配置
LOG_LEVEL=info
