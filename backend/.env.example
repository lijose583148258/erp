# 环境配置
NODE_ENV=development
PORT=5001

# 数据库配置
# 单机默认使用 SQLite，方便直接启动和备份
DATABASE_URL="file:%LOCALAPPDATA%/AilaoDaRuntime/stable.db"
# 后续如果要切到 PostgreSQL，可改成下面的形式
# DATABASE_URL="postgresql://postgres:password@localhost:5432/pro_sales?schema=public"

# JWT 配置
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 邮件配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-password

# 文件上传
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS 配置
CORS_ORIGIN=http://localhost:3000

# 日志配置
LOG_LEVEL=info
