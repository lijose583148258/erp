{
  "apiVersion": "postgresql.cnpg.io/v1",
  "kind": "Cluster",
  "metadata": {
    "name": "template-only",
    "namespace": "replace-with-recovery-namespace",
    "annotations": {
      "erp.ailaoda.io/backup-adapter-template": "v1"
    }
  },
  "spec": {
    "instances": 1,
    "bootstrap": {
      "recovery": {
        "source": "source"
      }
    },
    "externalClusters": [
      {
        "name": "source",
        "plugin": {
          "name": "barman-cloud.cloudnative-pg.io",
          "parameters": {
            "barmanObjectName": "replace-with-read-only-recovery-object-store",
            "serverName": "replace-with-source-cluster-name"
          }
        }
      }
    ],
    "storage": {
      "size": "replace-with-reviewed-restore-size"
    }
  }
}
